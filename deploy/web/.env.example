# Скопируйте в .env рядом с docker-compose.yml и задайте свой пароль.
#
# Через этот интерфейс доступно восстановление на любой подключённый
# сервер, то есть по сути root на всех них. Пароль здесь - единственное,
# что стоит между этим и посторонним.

AUTOBAK_PASSWORD=замените-на-длинный-пароль

# Необязательно:
# AUTOBAK_USER=admin
# TZ=Europe/Moscow
